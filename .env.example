NEO4J_URI=neo4j+s://dbid.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-your-aura-password
NEO4J_DATABASE=neo4j

# Optional: comma-separated subset for short local runs. When unset, ingest all Pokémon from the list URL.
# POKEGRAPH_POKEMON_NAMES=pikachu,charizard,tyranitar
POKEGRAPH_POKEAPI_POKEMON_LIST_URL=https://pokeapi.co/api/v2/pokemon?limit=100000&offset=0
POKEGRAPH_POKEAPI_CACHE_SIZE=2000
